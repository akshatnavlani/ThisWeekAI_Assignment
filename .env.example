# Google Gemini (required for research / draft / writing in later milestones)
GEMINI_API_KEY=

# Flash-class model ID that supports generateContent (e.g. gemini-3.5-flash-lite).
# Do NOT use Live/WebSocket-only IDs (names containing "live") — they return HTTP 400.
GEMINI_MODEL=

# SQLite path (created on first open / migrate-on-open)
# Local npm: ./data/editorial.db
# Docker Compose / Render: /data/editorial.db (persistent volume)
DATABASE_PATH=./data/editorial.db

# Optional: X/Twitter API bearer for tweet URL auto-fetch
X_BEARER_TOKEN=
