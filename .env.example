# Google Gemini (required for research / draft / writing in later milestones)
GEMINI_API_KEY=

# Flash-class model ID that supports generateContent (e.g. gemini-3.8-flash).
# Do not use Live/WebSocket-only model IDs here.
GEMINI_MODEL=

# Local SQLite path (created in M1+)
DATABASE_PATH=./data/editorial.db

# Optional: X/Twitter API bearer for tweet URL auto-fetch
X_BEARER_TOKEN=
